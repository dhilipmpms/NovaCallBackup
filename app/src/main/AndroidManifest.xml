<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read the call log for backups, comparison and duplicate detection. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Insert backed-up entries into the call log during restore. -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Optional: find archived calls by a current contact's numbers (requested only when enabled in Search). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- WorkManager declares this for network constraints, which this app never uses. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Needed on Android 11+ to detect whether the device has a call-log provider. -->
    <queries>
        <provider android:authorities="call_log" />
    </queries>

    <application
        android:name="org.opencall.archive.OpenCallApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCall"
        tools:targetApi="36">

        <activity
            android:name="org.opencall.archive.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.opencall.archive.ui.BackupDetailActivity"
            android:exported="false" />
        <activity
            android:name="org.opencall.archive.ui.RestoreActivity"
            android:exported="false" />
        <activity
            android:name="org.opencall.archive.ui.CompareActivity"
            android:exported="false" />
    </application>
</manifest>
